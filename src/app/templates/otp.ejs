<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>Your Verification Code</title>
    <style>
      /* Dark mode overrides — only respected by clients that support prefers-color-scheme */
      @media (prefers-color-scheme: dark) {
        .email-body {
          background-color: #0f172a !important;
        }
        .email-card {
          background-color: #1e293b !important;
        }
        .email-title {
          color: #f1f5f9 !important;
        }
        .email-text {
          color: #cbd5e1 !important;
        }
        .otp-box {
          background-color: #334155 !important;
          color: #38bdf8 !important;
        }
        .email-footer {
          color: #94a3b8 !important;
        }
      }
    </style>
  </head>
  <body
    class="email-body"
    style="
      margin: 0;
      padding: 0;
      background-color: #f1f5f9;
      font-family:
        -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial,
        sans-serif;
    "
  >
    <!-- Preheader: hidden text shown in inbox preview -->
    <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all">
      Your one-time verification code is inside. It expires in 5 minutes.
    </div>

    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f1f5f9; padding: 32px 16px"
    >
      <tr>
        <td align="center">
          <!-- Card -->
          <table
            role="presentation"
            class="email-card"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 520px;
              background-color: #ffffff;
              border-radius: 16px;
              box-shadow: 0 4px 24px rgba(15, 23, 42, 0.08);
              overflow: hidden;
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="
                  background: linear-gradient(135deg, #0ea5e9 0%, #6366f1 100%);
                  padding: 32px 24px;
                "
              >
                <div
                  style="font-size: 28px; line-height: 1; margin-bottom: 8px"
                >
                  🔐
                </div>
                <h1
                  class="email-title"
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 20px;
                    font-weight: 600;
                    letter-spacing: -0.01em;
                  "
                >
                  Verify Your Email
                </h1>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 32px 32px 8px 32px">
                <h2
                  class="email-title"
                  style="
                    margin: 0 0 12px 0;
                    color: #0f172a;
                    font-size: 18px;
                    font-weight: 600;
                  "
                >
                  Hello <%= name %> 👋
                </h2>
                <p
                  class="email-text"
                  style="
                    margin: 0 0 24px 0;
                    color: #475569;
                    font-size: 15px;
                    line-height: 1.6;
                  "
                >
                  Thanks for signing up. Use the verification code below to
                  complete your registration. This code is valid for
                  <strong>5 minutes</strong>.
                </p>
              </td>
            </tr>

            <!-- OTP Box -->
            <tr>
              <td align="center" style="padding: 0 32px 24px 32px">
                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  width="100%"
                >
                  <tr>
                    <td
                      align="center"
                      class="otp-box"
                      style="
                        background-color: #f0f9ff;
                        border: 2px dashed #0ea5e9;
                        border-radius: 12px;
                        padding: 20px 16px;
                      "
                    >
                      <div
                        style="
                          font-size: 12px;
                          letter-spacing: 0.15em;
                          text-transform: uppercase;
                          color: #0284c7;
                          font-weight: 600;
                          margin-bottom: 8px;
                        "
                      >
                        Your OTP Code
                      </div>
                      <div
                        style="
                          font-family:
                            'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono',
                            Consolas, monospace;
                          font-size: 36px;
                          font-weight: 700;
                          letter-spacing: 0.35em;
                          color: #0f172a;
                          padding-left: 0.35em;
                        "
                      >
                        <%= otp %>
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Warning -->
            <tr>
              <td style="padding: 0 32px 24px 32px">
                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  width="100%"
                  style="
                    background-color: #fef3c7;
                    border-left: 4px solid #f59e0b;
                    border-radius: 6px;
                  "
                >
                  <tr>
                    <td style="padding: 12px 16px">
                      <p
                        class="email-text"
                        style="
                          margin: 0;
                          color: #92400e;
                          font-size: 13px;
                          line-height: 1.5;
                        "
                      >
                        ⏱️ <strong>Expires in 5 minutes.</strong> If you didn't
                        request this code, you can safely ignore this email.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding: 0 32px">
                <div style="height: 1px; background-color: #e2e8f0"></div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding: 20px 32px 28px 32px">
                <p
                  class="email-footer"
                  style="
                    margin: 0;
                    color: #94a3b8;
                    font-size: 12px;
                    line-height: 1.6;
                    text-align: center;
                  "
                >
                  Need help? Contact us at
                  <a
                    href="mailto:support@yourapp.com"
                    style="color: #0ea5e9; text-decoration: none"
                    >support@yourapp.com</a
                  >
                </p>
                <p
                  class="email-footer"
                  style="
                    margin: 8px 0 0 0;
                    color: #94a3b8;
                    font-size: 11px;
                    text-align: center;
                  "
                >
                  © <%= new Date().getFullYear() %> Your App. All rights
                  reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
